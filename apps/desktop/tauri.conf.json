{
  "build": {
    "beforeBuildCommand": "npm run build -w apps/web",
    "beforeDevCommand": "npm run dev -w apps/web",
    "devPath": "http://localhost:3000",
    "frontendDist": "../../apps/web/.next"
  },
  "app": {
    "windows": [
      {
        "title": "Dark Souls I Guide",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' https: data:; font-src 'self' https://fonts.gstatic.com"
    }
  },
  "package": {
    "productName": "Dark Souls I Guide",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "execute": true,
        "open": true
      },
      "fs": {
        "all": false,
        "readDir": true,
        "readFile": true,
        "writeFile": true,
        "createDir": true,
        "removeDir": true,
        "removeFile": true,
        "renameFile": true,
        "copyFile": true
      },
      "path": {
        "all": true
      },
      "window": {
        "all": false,
        "create": true,
        "center": true,
        "close": true,
        "hide": true,
        "show": true,
        "maximize": true,
        "minimize": true,
        "unmaximize": true,
        "unminimize": true,
        "setDecorations": true,
        "setAlwaysOnTop": true,
        "setSize": true,
        "setPosition": true,
        "setTitle": true,
        "setFullscreen": true,
        "startDragging": true
      },
      "notification": {
        "all": true
      },
      "dialog": {
        "all": true,
        "open": true,
        "save": true,
        "message": true,
        "ask": true,
        "confirm": true
      },
      "http": {
        "all": false,
        "request": true,
        "scope": ["http://*", "https://*"]
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.darkssouls.guide",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    }
  }
}
