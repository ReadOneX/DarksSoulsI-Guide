{
  "productName": "Dark Souls I Guide",
  "version": "1.0.0",
  "identifier": "com.darkssouls.guide",
  "build": {
    "beforeBuildCommand": "npm run build -w apps/web",
    "beforeDevCommand": "npm run dev -w apps/web",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../web/.next"
  },
  "app": {
    "windows": [
      {
        "title": "Dark Souls I Guide",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; font-src 'self' https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "execute": true,
        "open": true
      },
      "fs": {
        "all": false,
        "readDir": true,
        "readFile": true,
        "writeFile": true
      },
      "window": {
        "all": false,
        "close": true,
        "hide": true,
        "show": true,
        "maximize": true,
        "minimize": true,
        "unmaximize": true,
        "unminimize": true,
        "setTitle": true
      },
      "http": {
        "all": false,
        "request": true,
        "scope": ["http://localhost:3001/*", "http://localhost:3000/*", "http://127.0.0.1:3001/*"]
      }
    }
  }
}
